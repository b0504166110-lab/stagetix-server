<?xml version="1.0" encoding="utf-8" ?>
<!--
  NLog configuration. The application code only uses Microsoft's ILogger<T>; NLog is plugged in underneath
  (builder.Host.UseNLog in Program.cs).

  Which levels are written is decided by "Logging:LogLevel" in appsettings.json / appsettings.Development.json
  (Debug in development, Information in production). This file decides WHERE and in WHAT FORMAT.

  Every line contains the request's correlation id (${aspnet-TraceIdentifier}), set by CorrelationIdMiddleware.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogToConsole="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <variable name="line"
            value="${longdate:universalTime=true}Z | ${level:uppercase=true:padding=-5} | ${aspnet-TraceIdentifier:ignoreActivityId=true:whenEmpty=-} | ${logger:shortName=true} | ${message}${onexception:inner= | ${exception:format=tostring}}" />

  <targets>
    <!-- Console: what you see in the terminal locally and in the Render "Logs" tab. -->
    <target xsi:type="Console" name="console" layout="${line}" />

    <!-- Daily file, kept for 7 days. Folder "logs" is in .gitignore. -->
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/stagetix-${shortdate}.log"
            layout="${line}"
            maxArchiveFiles="7"
            encoding="utf-8" />
  </targets>

  <rules>
    <logger name="*" minlevel="Trace" writeTo="console,file" />
  </rules>
</nlog>
