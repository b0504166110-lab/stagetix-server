<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Same id as StageTix.API, so the PostgreSQL concurrency tests find the developer's connection string. -->
    <UserSecretsId>009ef80a-423d-4544-a3a8-21b3e1e514e7</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed to test the middleware and the controllers of the API project. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StageTix.API\StageTix.API.csproj" />
    <ProjectReference Include="..\StageTix.Service\StageTix.Service.csproj" />
    <ProjectReference Include="..\StageTix.Core\StageTix.Core.csproj" />
    <ProjectReference Include="..\StageTix.Data\StageTix.Data.csproj" />
  </ItemGroup>

</Project>
